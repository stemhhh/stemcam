; WinUSB binding for Google AOA accessory used by OBS Phone Cam
; VID_18D1 PID_2D00 / PID_2D01

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ManufacturerName%
DriverVer   = 11/02/2026,1.0.0.0
CatalogFile = opcm_accessory.cat

[Manufacturer]
%ManufacturerName% = Devices,NTamd64

[Devices.NTamd64]
%DeviceNameAcc%    = USB_Install, USB\VID_18D1&PID_2D00
%DeviceNameAccAdb% = USB_Install, USB\VID_18D1&PID_2D01

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{DEE82515-0C0F-4E4A-9A8B-0F0C0B0A0C0D}"

[Strings]
ManufacturerName = "OBSPhoneCam"
DeviceNameAcc    = "OBS Phone Cam USB Accessory"
DeviceNameAccAdb = "OBS Phone Cam USB Accessory (ADB)"
